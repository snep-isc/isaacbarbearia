rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
		// Padrão: negar tudo
		match /{document=**} {
			allow read, write: if false;
		}

		// Avaliações: um documento por UID. Sem e-mail no documento público.
		match /avaliacoes/{uid} {
			allow read: if true;

			allow create: if (
				(estaAutenticado() && uid == request.auth.uid) || isAdmin()
			) && avaliacaoValida();

			allow update: if (
				(estaAutenticado() && uid == request.auth.uid) || isAdmin()
			) && avaliacaoValida();

			allow delete: if isAdmin() || (estaAutenticado() && uid == request.auth.uid);
		}

		// Reviews (coleções alternativas)
		match /reviews/{doc=**} {
			allow read, create, update, delete: if isAdmin();
		}

		match /Reviews/{doc=**} {
			allow read, create, update, delete: if isAdmin();
		}

		// Feedback (coleções antigas)
		match /feedback/{doc=**} {
			allow read, create, update, delete: if isAdmin();
		}

		match /feedbacks/{doc=**} {
			allow read, create, update, delete: if isAdmin();
		}

		// Profissionais (Professionals)
		match /profissionais/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Parceiros
		match /parceiros/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Participações (Participations)
		match /participacoes/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Horários (Opening hours)
		match /horarios/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Agendamento (Scheduling)
		match /agendamento/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Avisos (Warnings)
		match /avisos/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Localização (Location)
		match /localizacao/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Serviços (Services)
		match /servicos/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		// Config
		match /config/{doc=**} {
			allow read: if true;
			allow create, update, delete: if isAdmin();
		}

		function estaAutenticado() {
			return request.auth != null
				&& request.auth.token.email_verified == true
				&& request.auth.token.email != null;
		}

		function avaliacaoValida() {
			let dados = request.resource.data;
			return dados.keys().hasOnly(['cliente', 'comentario', 'estrelas', 'data', 'photoURL'])
				&& dados.cliente is string && dados.cliente.size() > 0 && dados.cliente.size() <= 80
				&& dados.comentario is string && dados.comentario.size() > 0 && dados.comentario.size() <= 1000
				&& dados.estrelas is int && dados.estrelas >= 1 && dados.estrelas <= 5
				&& dados.data is string && dados.data.size() <= 30
				&& dados.photoURL is string && dados.photoURL.size() <= 500;
		}

		// Recomendado: custom claim admin=true definida pelo Admin SDK.
		// A alternativa por e-mail exige e-mail verificado para impedir conta recém-criada.
		function isAdmin() {
			return request.auth != null && (
				request.auth.token.admin == true ||
				(request.auth.token.email == 'admin@isaacbarbearia.com'
					&& request.auth.token.email_verified == true)
			);
		}
	}
}
